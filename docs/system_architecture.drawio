<mxfile host="app.diagrams.net">
  <diagram name="System Architecture" id="system-arch-1">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- 사용자(브라우저) -->
        <mxCell id="2" value="사용자(브라우저)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe7;strokeColor=#ff9800;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- React 프론트엔드 (Nginx) -->
        <mxCell id="3" value="React 프론트엔드 (Nginx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#2196f3;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="200" height="60" as="geometry" />
        </mxCell>
        <!-- Flask 백엔드 API -->
        <mxCell id="4" value="Flask 백엔드 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="180" height="60" as="geometry" />
        </mxCell>
        <!-- MySQL DB -->
        <mxCell id="5" value="MySQL DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e24aa;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="120" height="60" as="geometry" />
        </mxCell>
        <!-- Docker Compose Network (Container) -->
        <mxCell id="6" value="Docker Compose Network" style="swimlane;html=1;fillColor=#f5f5f5;strokeColor=#90a4ae;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="780" height="180" as="geometry" />
        </mxCell>
        <!-- 연결선: 사용자 → Nginx -->
        <mxCell id="7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2196f3;strokeWidth=2;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 연결선: Nginx → Flask (/api 프록시) -->
        <mxCell id="8" value="/api/* 프록시" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#43a047;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 연결선: Nginx → Nginx (정적 파일/SPA) -->
        <mxCell id="9" value="정적 파일/SPA 라우팅" style="edgeStyle=loopEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#2196f3;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="3" target="3">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="160" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- 연결선: Flask → MySQL -->
        <mxCell id="10" value="SQL 쿼리" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8e24aa;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 연결선: Flask → Flask (JWT 인증/검증) -->
        <mxCell id="11" value="JWT 인증/검증" style="edgeStyle=loopEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#43a047;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="4" target="4">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="160" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- Docker Compose Network 컨테이너화 -->
        <mxCell id="12" style="container=1;recursiveResize=0;" vertex="1" parent="6">
          <mxGeometry x="0" y="0" width="780" height="180" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="12" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#2196f3;fontSize=16;fontStyle=1;" value="React 프론트엔드 (Nginx)">
          <mxGeometry x="40" y="20" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="14" parent="12" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontSize=16;fontStyle=1;" value="Flask 백엔드 API">
          <mxGeometry x="320" y="20" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="15" parent="12" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e24aa;fontSize=16;fontStyle=1;" value="MySQL DB">
          <mxGeometry x="600" y="20" width="120" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>