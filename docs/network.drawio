<mxfile host="app.diagrams.net">
  <diagram name="Network" id="network-1">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- 사용자(브라우저) -->
        <mxCell id="2" value="사용자(브라우저)\n(Host)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe7;strokeColor=#ff9800;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- Host OS (localhost) -->
        <mxCell id="3" value="Host OS\n(localhost)" style="swimlane;html=1;fillColor=#f5f5f5;strokeColor=#90a4ae;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1120" height="320" as="geometry" />
        </mxCell>
        <!-- Docker Bridge Network -->
        <mxCell id="4" value="Docker bridge 네트워크" style="swimlane;html=1;fillColor=#e3f2fd;strokeColor=#2196f3;fontSize=14;" vertex="1" parent="3">
          <mxGeometry x="40" y="40" width="1040" height="220" as="geometry" />
        </mxCell>
        <!-- frontend 컨테이너 -->
        <mxCell id="5" value="frontend (Nginx+React)\n컨테이너\n서비스명: frontend\n내부: 80\n외부: 3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#2196f3;fontSize=15;fontStyle=1;" vertex="1" parent="4">
          <mxGeometry x="80" y="80" width="220" height="100" as="geometry" />
        </mxCell>
        <!-- web 컨테이너 -->
        <mxCell id="6" value="web (Flask)\n컨테이너\n서비스명: web\n내부: 5000\n외부: 8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontSize=15;fontStyle=1;" vertex="1" parent="4">
          <mxGeometry x="400" y="80" width="220" height="100" as="geometry" />
        </mxCell>
        <!-- db 컨테이너 -->
        <mxCell id="7" value="db (MySQL)\n컨테이너\n서비스명: db\n내부: 3306\n외부: 13306" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#8e24aa;fontSize=15;fontStyle=1;" vertex="1" parent="4">
          <mxGeometry x="720" y="80" width="220" height="100" as="geometry" />
        </mxCell>
        <!-- 연결선: 사용자 → frontend -->
        <mxCell id="8" value="HTTP 3000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2196f3;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="2" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 연결선: frontend → web (/api 프록시) -->
        <mxCell id="9" value="/api 프록시\n내부 80→5000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#43a047;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 연결선: web → db (SQL) -->
        <mxCell id="10" value="SQL 3306" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8e24aa;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 연결선: Host OS → frontend (포트포워딩) -->
        <mxCell id="11" value="포트포워딩 3000→80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#2196f3;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="3" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 연결선: Host OS → web (포트포워딩) -->
        <mxCell id="12" value="포트포워딩 8000→5000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#43a047;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="3" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 연결선: Host OS → db (포트포워딩) -->
        <mxCell id="13" value="포트포워딩 13306→3306" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#8e24aa;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="3" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 네트워크 설명 -->
        <mxCell id="14" value="모든 컨테이너는 Docker bridge 네트워크에서 서비스명으로 통신 (DNS 지원)\nNginx가 /api는 web(Flask)로, 나머지는 정적 파일로 프록시" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=14;" vertex="1" parent="4">
          <mxGeometry x="320" y="190" width="600" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>